{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpds.football/schema/v0.1/player.json",
  "title": "FPDS Player Submission",
  "description": "Football Player Data Standard v0.1.0 - a single player submission.",
  "type": "object",
  "required": [
    "fpds_version",
    "submission",
    "player",
    "positions",
    "contract",
    "representation",
    "consent"
  ],
  "additionalProperties": false,
  "properties": {
    "fpds_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "submission": {
      "type": "object",
      "required": [
        "submission_id",
        "submitted_at",
        "purpose"
      ],
      "additionalProperties": false,
      "properties": {
        "submission_id": {
          "type": "string",
          "minLength": 1
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "permanent_transfer",
            "loan",
            "trial",
            "free_agent_offer",
            "information_only"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "player": {
      "type": "object",
      "required": [
        "full_name",
        "date_of_birth",
        "nationalities",
        "current_club"
      ],
      "additionalProperties": false,
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 1
        },
        "known_as": {
          "type": "string"
        },
        "date_of_birth": {
          "type": "string",
          "format": "date"
        },
        "nationalities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "preferred_foot": {
          "enum": [
            "left",
            "right",
            "both",
            "unknown"
          ]
        },
        "height_cm": {
          "type": "integer",
          "minimum": 120,
          "maximum": 230
        },
        "current_club": {
          "type": "object",
          "required": [
            "name",
            "country"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "competition": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          }
        },
        "external_ids": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fifa_connect_id": {
              "type": "string"
            },
            "transfermarkt_id": {
              "type": "string"
            },
            "wyscout_id": {
              "type": "string"
            },
            "opta_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "positions": {
      "type": "object",
      "required": [
        "primary_position"
      ],
      "additionalProperties": false,
      "properties": {
        "primary_position": {
          "$ref": "#/$defs/positionCode"
        },
        "secondary_positions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/positionCode"
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "under_contract",
            "free_agent",
            "on_loan",
            "youth_scholarship",
            "unattached",
            "unknown"
          ]
        },
        "expiry_date": {
          "type": "string",
          "format": "date"
        },
        "option_to_extend": {
          "type": "boolean"
        },
        "release_clause": {
          "$ref": "#/$defs/money"
        },
        "sell_on_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "parent_club": {
          "type": "object",
          "required": [
            "name",
            "country"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "under_contract"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "expiry_date"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "on_loan"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "expiry_date",
              "parent_club"
            ]
          }
        }
      ]
    },
    "representation": {
      "type": "object",
      "required": [
        "agent_name",
        "mandate_status"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_name": {
          "type": "string",
          "minLength": 1
        },
        "agency": {
          "type": "string"
        },
        "fifa_agent_licence": {
          "type": "string"
        },
        "mandate_status": {
          "enum": [
            "exclusive",
            "non_exclusive",
            "club_mandate",
            "none",
            "unknown"
          ]
        },
        "mandate_expiry": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "available_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "permanent_transfer",
              "loan",
              "trial",
              "free_transfer"
            ]
          }
        },
        "available_from": {
          "type": "string",
          "format": "date"
        },
        "asking_price": {
          "$ref": "#/$defs/money"
        },
        "loan_fee": {
          "$ref": "#/$defs/money"
        },
        "wage_contribution_expected": {
          "type": "boolean"
        }
      }
    },
    "performance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "season",
          "competition",
          "competition_country",
          "appearances",
          "minutes"
        ],
        "additionalProperties": false,
        "properties": {
          "season": {
            "type": "string",
            "pattern": "^[0-9]{4}(/[0-9]{2})?$"
          },
          "competition": {
            "type": "string"
          },
          "competition_country": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "competition_tier": {
            "type": "integer",
            "minimum": 1
          },
          "appearances": {
            "type": "integer",
            "minimum": 0
          },
          "starts": {
            "type": "integer",
            "minimum": 0
          },
          "minutes": {
            "type": "integer",
            "minimum": 0
          },
          "goals": {
            "type": "integer",
            "minimum": 0
          },
          "assists": {
            "type": "integer",
            "minimum": 0
          },
          "clean_sheets": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passports": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "work_permit_required": {
          "type": "boolean"
        },
        "gbe_points": {
          "type": "integer",
          "minimum": 0
        },
        "homegrown_status": {
          "enum": [
            "hg_england",
            "hg_club",
            "hg_association",
            "none",
            "unknown"
          ]
        },
        "international_caps": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "medical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current_status": {
          "enum": [
            "available",
            "unavailable",
            "managed_load",
            "unknown"
          ]
        },
        "expected_return_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "media": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "type",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "highlights",
              "full_match",
              "scouting_report",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "recorded_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "consent": {
      "type": "object",
      "required": [
        "lawful_basis",
        "consent_obtained",
        "subject_is_minor"
      ],
      "additionalProperties": false,
      "properties": {
        "lawful_basis": {
          "enum": [
            "consent",
            "contract",
            "legitimate_interest",
            "legal_obligation",
            "not_stated"
          ]
        },
        "consent_obtained": {
          "type": "boolean"
        },
        "consent_date": {
          "type": "string",
          "format": "date"
        },
        "subject_is_minor": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "pattern": "^/"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "enum": [
              "verified",
              "third_party_data",
              "club_stated",
              "agent_stated",
              "estimated",
              "unknown"
            ]
          },
          "asserted_by": {
            "type": "string"
          },
          "asserted_at": {
            "type": "string",
            "format": "date-time"
          },
          "verified_against": {
            "type": "string"
          }
        },
        "if": {
          "properties": {
            "source": {
              "const": "verified"
            }
          },
          "required": [
            "source"
          ]
        },
        "then": {
          "required": [
            "verified_against"
          ]
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "positionCode": {
      "enum": [
        "GK",
        "RB",
        "LB",
        "RWB",
        "LWB",
        "CB",
        "DM",
        "CM",
        "AM",
        "RM",
        "LM",
        "RW",
        "LW",
        "SS",
        "ST"
      ]
    },
    "money": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0,
          "description": "Integer minor units, e.g. 250000000 is GBP 2,500,000."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "conditions": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
