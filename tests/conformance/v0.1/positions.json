{
  "description": "Position codes (SPEC section 6)",
  "schema": "schema/v0.1/player.json",
  "base": "examples/valid/midfielder-under-contract.json",
  "tests": [
    {
      "description": "free text in place of a position code is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/positions/primary_position",
          "value": "centre mid"
        }
      ],
      "valid": false
    },
    {
      "description": "a lowercase position code is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/positions/primary_position",
          "value": "cm"
        }
      ],
      "valid": false
    },
    {
      "description": "the first-draft code DM is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/positions/primary_position",
          "value": "DM"
        }
      ],
      "valid": false
    },
    {
      "description": "the first-draft code AM is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/positions/primary_position",
          "value": "AM"
        }
      ],
      "valid": false
    },
    {
      "description": "SS is not a position code",
      "patch": [
        {
          "op": "replace",
          "path": "/positions/primary_position",
          "value": "SS"
        }
      ],
      "valid": false
    },
    {
      "description": "a side-specific centre-back is accepted",
      "patch": [
        {
          "op": "replace",
          "path": "/positions/primary_position",
          "value": "LCB"
        }
      ],
      "valid": true
    },
    {
      "description": "a side-specific central midfielder is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/positions/primary_position",
          "value": "LCM"
        }
      ],
      "valid": false
    },
    {
      "description": "a missing primary position is rejected",
      "patch": [
        {
          "op": "remove",
          "path": "/positions/primary_position"
        }
      ],
      "valid": false
    },
    {
      "description": "secondary positions are optional",
      "patch": [
        {
          "op": "remove",
          "path": "/positions/secondary_positions"
        }
      ],
      "valid": true
    },
    {
      "description": "more than four secondary positions is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/positions/secondary_positions",
          "value": [
            "CDM",
            "CAM",
            "RM",
            "LM",
            "RW"
          ]
        }
      ],
      "valid": false
    },
    {
      "description": "a repeated secondary position is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/positions/secondary_positions",
          "value": [
            "CDM",
            "CDM"
          ]
        }
      ],
      "valid": false
    }
  ]
}
