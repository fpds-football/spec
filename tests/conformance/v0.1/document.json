{
  "description": "Document envelope and null values (SPEC sections 2 and 3)",
  "schema": "schema/v0.1/player.json",
  "base": "examples/valid/free-agent-minimal.json",
  "tests": [
    {
      "description": "the minimal document is valid",
      "patch": [],
      "valid": true
    },
    {
      "description": "a version from a later minor line is rejected by the 0.1 schema",
      "patch": [
        {
          "op": "replace",
          "path": "/fpds_version",
          "value": "0.2.0"
        }
      ],
      "valid": false
    },
    {
      "description": "a patch-level version within 0.1 is accepted",
      "patch": [
        {
          "op": "replace",
          "path": "/fpds_version",
          "value": "0.1.3"
        }
      ],
      "valid": true
    },
    {
      "description": "an unrecognised top-level member is rejected",
      "patch": [
        {
          "op": "add",
          "path": "/scouting_grade",
          "value": "B+"
        }
      ],
      "valid": false
    },
    {
      "description": "a member removed from the first draft is rejected",
      "patch": [
        {
          "op": "add",
          "path": "/medical",
          "value": {
            "current_status": "available"
          }
        }
      ],
      "valid": false
    },
    {
      "description": "null in place of a required value is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/player/full_name",
          "value": null
        }
      ],
      "valid": false
    },
    {
      "description": "null in place of an optional value is rejected",
      "patch": [
        {
          "op": "add",
          "path": "/player/external_ids",
          "value": null
        }
      ],
      "valid": false
    }
  ]
}
