{
  "description": "Submission block (SPEC section 4)",
  "schema": "schema/v0.1/player.json",
  "base": "examples/valid/midfielder-under-contract.json",
  "tests": [
    {
      "description": "two compatible purposes are accepted",
      "patch": [],
      "valid": true
    },
    {
      "description": "a version 4 UUID is accepted",
      "patch": [],
      "valid": true
    },
    {
      "description": "a version 7 UUID is accepted",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/submission_id",
          "value": "01928f3a-7b2c-7d4e-9f10-2a3b4c5d6e7f"
        }
      ],
      "valid": true
    },
    {
      "description": "a submission ID that is not a UUID is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/submission_id",
          "value": "SUB-2026-001"
        }
      ],
      "valid": false
    },
    {
      "description": "an uppercase UUID is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/submission_id",
          "value": "B7F3C2E1-4A9D-4F11-9C3E-2A1D5F8B0C44"
        }
      ],
      "valid": false
    },
    {
      "description": "a UUID without hyphens is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/submission_id",
          "value": "b7f3c2e14a9d4f119c3e2a1d5f8b0c44"
        }
      ],
      "valid": false
    },
    {
      "description": "the nil UUID is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/submission_id",
          "value": "00000000-0000-0000-0000-000000000000"
        }
      ],
      "valid": false
    },
    {
      "description": "an empty purposes array is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/purposes",
          "value": []
        }
      ],
      "valid": false
    },
    {
      "description": "a repeated purpose is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/purposes",
          "value": [
            "loan",
            "loan"
          ]
        }
      ],
      "valid": false
    },
    {
      "description": "a purpose outside the vocabulary is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/purposes",
          "value": [
            "enquiry"
          ]
        }
      ],
      "valid": false
    },
    {
      "description": "free_agent_offer is no longer a purpose",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/purposes",
          "value": [
            "free_agent_offer"
          ]
        }
      ],
      "valid": false
    },
    {
      "description": "information_only on its own is accepted",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/purposes",
          "value": [
            "information_only"
          ]
        }
      ],
      "valid": true
    },
    {
      "description": "information_only with another purpose is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/purposes",
          "value": [
            "information_only",
            "loan"
          ]
        }
      ],
      "valid": false
    },
    {
      "description": "a single purpose string in place of the array is rejected",
      "patch": [
        {
          "op": "remove",
          "path": "/submission/purposes"
        },
        {
          "op": "add",
          "path": "/submission/purpose",
          "value": "loan"
        }
      ],
      "valid": false
    },
    {
      "description": "a missing sender is rejected",
      "patch": [
        {
          "op": "remove",
          "path": "/submission/sender"
        }
      ],
      "valid": false
    },
    {
      "description": "a sender outside the vocabulary is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/sender",
          "value": "club"
        }
      ],
      "valid": false
    },
    {
      "description": "a submission time without a time zone is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/submission/submitted_at",
          "value": "2026-09-13T09:41:00"
        }
      ],
      "valid": false
    },
    {
      "description": "a free-text note is rejected",
      "patch": [
        {
          "op": "add",
          "path": "/submission/note",
          "value": "Open to offers."
        }
      ],
      "valid": false
    }
  ]
}
