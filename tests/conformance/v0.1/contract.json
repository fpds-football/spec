{
  "description": "Contract status, current club and loans (SPEC section 7)",
  "schema": "schema/v0.1/player.json",
  "base": "examples/valid/midfielder-under-contract.json",
  "tests": [
    {
      "description": "under_contract with an expiry date and a current club is valid",
      "patch": [],
      "valid": true
    },
    {
      "description": "under_contract without an expiry date is rejected",
      "patch": [
        {
          "op": "remove",
          "path": "/contract/expiry_date"
        },
        {
          "op": "remove",
          "path": "/provenance/~1contract~1expiry_date"
        }
      ],
      "valid": false
    },
    {
      "description": "under_contract without a current club is rejected",
      "patch": [
        {
          "op": "remove",
          "path": "/player/current_club"
        }
      ],
      "valid": false
    },
    {
      "description": "under_contract with a parent club is rejected",
      "patch": [
        {
          "op": "add",
          "path": "/contract/parent_club",
          "value": {
            "name": "Legia Warszawa",
            "country": "POL"
          }
        }
      ],
      "valid": false
    },
    {
      "description": "on_loan without a parent club is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "on_loan"
        }
      ],
      "valid": false
    },
    {
      "description": "on_loan with an expiry date, a current club and a parent club is accepted",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "on_loan"
        },
        {
          "op": "add",
          "path": "/contract/parent_club",
          "value": {
            "name": "Legia Warszawa",
            "country": "POL"
          }
        }
      ],
      "valid": true
    },
    {
      "description": "amateur with a current club is accepted",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "amateur"
        },
        {
          "op": "remove",
          "path": "/contract/expiry_date"
        },
        {
          "op": "remove",
          "path": "/provenance/~1contract~1expiry_date"
        }
      ],
      "valid": true
    },
    {
      "description": "amateur with an expiry date is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "amateur"
        }
      ],
      "valid": false
    },
    {
      "description": "amateur without a current club is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "amateur"
        },
        {
          "op": "remove",
          "path": "/contract/expiry_date"
        },
        {
          "op": "remove",
          "path": "/provenance/~1contract~1expiry_date"
        },
        {
          "op": "remove",
          "path": "/player/current_club"
        }
      ],
      "valid": false
    },
    {
      "description": "free_agent without a current club is accepted",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "free_agent"
        },
        {
          "op": "remove",
          "path": "/contract/expiry_date"
        },
        {
          "op": "remove",
          "path": "/provenance/~1contract~1expiry_date"
        },
        {
          "op": "remove",
          "path": "/player/current_club"
        }
      ],
      "valid": true
    },
    {
      "description": "free_agent with a current club is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "free_agent"
        },
        {
          "op": "remove",
          "path": "/contract/expiry_date"
        },
        {
          "op": "remove",
          "path": "/provenance/~1contract~1expiry_date"
        }
      ],
      "valid": false
    },
    {
      "description": "free_agent with an expiry date is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "free_agent"
        },
        {
          "op": "remove",
          "path": "/player/current_club"
        }
      ],
      "valid": false
    },
    {
      "description": "unknown without a current club is accepted",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "unknown"
        },
        {
          "op": "remove",
          "path": "/contract/expiry_date"
        },
        {
          "op": "remove",
          "path": "/provenance/~1contract~1expiry_date"
        },
        {
          "op": "remove",
          "path": "/player/current_club"
        }
      ],
      "valid": true
    },
    {
      "description": "unknown with a current club is accepted",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "unknown"
        },
        {
          "op": "remove",
          "path": "/contract/expiry_date"
        },
        {
          "op": "remove",
          "path": "/provenance/~1contract~1expiry_date"
        }
      ],
      "valid": true
    },
    {
      "description": "youth_scholarship is no longer a status",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "youth_scholarship"
        },
        {
          "op": "remove",
          "path": "/contract/expiry_date"
        },
        {
          "op": "remove",
          "path": "/provenance/~1contract~1expiry_date"
        }
      ],
      "valid": false
    },
    {
      "description": "unattached is no longer a status",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "unattached"
        },
        {
          "op": "remove",
          "path": "/contract/expiry_date"
        },
        {
          "op": "remove",
          "path": "/provenance/~1contract~1expiry_date"
        },
        {
          "op": "remove",
          "path": "/player/current_club"
        }
      ],
      "valid": false
    },
    {
      "description": "an unrecognised contract status is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/contract/status",
          "value": "out_of_contract"
        }
      ],
      "valid": false
    },
    {
      "description": "a release clause is not in the core",
      "patch": [
        {
          "op": "add",
          "path": "/contract/release_clause",
          "value": {
            "amount": 180000000,
            "currency": "EUR"
          }
        }
      ],
      "valid": false
    }
  ]
}
