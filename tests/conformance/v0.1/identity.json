{
  "description": "Identity and dates (SPEC section 5)",
  "schema": "schema/v0.1/player.json",
  "base": "examples/valid/midfielder-under-contract.json",
  "tests": [
    {
      "description": "a two-letter country code is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/player/nationalities",
          "value": [
            "PL"
          ]
        }
      ],
      "valid": false
    },
    {
      "description": "an empty nationalities array is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/player/nationalities",
          "value": []
        }
      ],
      "valid": false
    },
    {
      "description": "a repeated nationality is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/player/nationalities",
          "value": [
            "POL",
            "POL"
          ]
        }
      ],
      "valid": false
    },
    {
      "description": "a date of birth in day-first format is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/player/date_of_birth",
          "value": "17/04/2003"
        }
      ],
      "valid": false
    },
    {
      "description": "a date of birth without separators is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/player/date_of_birth",
          "value": "20030417"
        }
      ],
      "valid": false
    },
    {
      "description": "a date of birth that does not exist is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/player/date_of_birth",
          "value": "2003-02-30"
        }
      ],
      "valid": false
    },
    {
      "description": "an empty name is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/player/full_name",
          "value": ""
        }
      ],
      "valid": false
    },
    {
      "description": "a vendor identifier is rejected",
      "patch": [
        {
          "op": "add",
          "path": "/player/external_ids/transfermarkt_id",
          "value": "612344"
        }
      ],
      "valid": false
    },
    {
      "description": "a field removed from the first draft is rejected",
      "patch": [
        {
          "op": "add",
          "path": "/player/height_cm",
          "value": 183
        }
      ],
      "valid": false
    },
    {
      "description": "a club without a country is rejected",
      "patch": [
        {
          "op": "replace",
          "path": "/player/current_club",
          "value": {
            "name": "Widzew Lodz"
          }
        }
      ],
      "valid": false
    }
  ]
}
