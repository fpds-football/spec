# Cloudflare Workers static asset response headers. See DECISIONS.md D-5 and D-30.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src https://tally.so; script-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/schema/*
  Content-Type: application/schema+json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
